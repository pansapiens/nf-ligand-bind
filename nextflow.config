manifest {
    name            = 'nf-ligand-bind'
    author          = """Andrew Perry"""
    homePage        = 'https://github.com/pansapiens/nf-ligand-bind'
    description     = """Ligand binding prediction pipeline"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.1'
    // doi             = 'TBD'
}

process {
    executor = 'slurm'
    stageInMode = 'symlink'
    // errorStrategy = 'retry'
    maxRetries = 0
    cache = 'lenient'

    withName: DYNAMICBIND {
        accelerator = 1
        time = 24.hours
        memory = '16g' // '8g' is probably enough
        cpus = 8      // dynamicbind default is 20 cores for relaxation
    }
}

// Apptainer specific settings
apptainer {
    enabled = true
    autoMounts = true
    pullTimeout = 3.hours
    // --nv to enable NVIDIA GPU support
    runOptions = "--nv"
}

docker {
    // --gpus all to enable NVIDIA GPU support
    runOptions = '--gpus all'
}

profiles {
    local {
        executor {
            name = 'local'
            queueSize = 32
            pollInterval = '30 sec'
        }
        process {
            executor = 'local'
            stageInMode = 'symlink'
            maxRetries = 0
            cache = 'lenient'
        }
    }
    slurm {
        executor {
            name = 'slurm'
            queueSize = 900
            pollInterval = '30 sec'
            queueStatInterval = '10m'
        }
        process {
            executor = 'slurm'
            stageInMode = 'symlink'
            // errorStrategy = 'retry'
            maxRetries = 0
            cache = 'lenient'
        }
    }
}
