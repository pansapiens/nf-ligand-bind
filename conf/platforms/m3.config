process {
    executor = 'slurm'
    stageInMode = 'symlink'
    // errorStrategy = 'retry'
    maxRetries = 0
    cache = 'lenient'

    withName: DYNAMICBIND {
        // container = "dynamicbind_latest.sif"
        accelerator = 1
        time = 24.hours
        memory = '32g' // '8g' is probably enough
        cpus = 32      // dynamicbind default is 20 cores for relaxation
        clusterOptions = "--account ${params.slurm_account} --gres=gpu:1 --partition=bdi --qos=bdiq"
        //clusterOptions = "--account ${params.slurm_account} --gres=gpu:1 --partition=m3h --qos=m3h"
    }
}